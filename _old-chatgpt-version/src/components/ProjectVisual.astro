---
import type { Project } from '../data/portfolio';

interface Props {
  visual: Project['visual'];
  eager?: boolean;
}

const { visual, eager = false } = Astro.props;
const captions = {
  orian: 'Illustration of a local 3D generation workspace',
  reqsy: 'Illustration of an idea research workflow, with sample data',
  pixelpeek: 'Illustration of a paired Android phone and desktop testing dashboard',
  catercore: 'Illustration of an event operations dashboard, with sample data',
  stevie: 'Illustration of natural-language award search, with a sample query',
  tracking: 'Illustration of short-link attribution and reporting, with sample data',
};
const modes = ['Discover', 'Images', 'Music', '3D Assets', 'Video'];
const steps = ['Interview', 'Gather evidence', 'Review assumptions'];
const records = [
  { name: 'Garden reception', type: 'Private event', status: 'Confirmed' },
  { name: 'Studio lunch', type: 'Corporate event', status: 'Pending' },
  { name: 'Gallery opening', type: 'Reception', status: 'Draft' },
];
---

<figure class:list={['project-figure', `visual-${visual}`]}>
  <div class="project-visual" aria-hidden="true">
    {visual === 'orian' && (
      <div class="app-window orian-window">
        <div class="window-bar"><span class="window-buttons"><i></i><i></i><i></i></span><strong>Orian Studio</strong><span>Local workspace</span></div>
        <div class="orian-body">
          <div class="orian-sidebar">
            <span>MEDIA STUDIO</span>
            {modes.map((mode) => <span class:list={{ 'mode-active': mode === '3D Assets' }}>{mode}</span>)}
          </div>
          <div class="orian-image">
            <img
              src="/media/orian-640.webp"
              srcset="/media/orian-640.webp 640w, /media/orian-1200.webp 1200w"
              sizes={eager ? '(max-width: 800px) 95vw, 910px' : '(max-width: 800px) 90vw, 540px'}
              width="640" height="426" loading={eager ? 'eager' : 'lazy'} decoding="async" alt=""
            />
            <div class="orian-image-bar"><span>Asset preview</span><span>Export GLB</span></div>
          </div>
        </div>
      </div>
    )}
    {visual === 'reqsy' && (
      <div class="app-window paper-window">
        <div class="window-bar"><span class="window-buttons"><i></i><i></i><i></i></span><strong>Reqsy AI</strong><span>Research brief</span></div>
        <div class="reqsy-body">
          <div class="reqsy-page">
            <span>RESEARCH BRIEF</span>
            <strong>Local food discovery</strong>
            <div class="mock-rule"></div>
            <div class="mock-line"></div><div class="mock-line mock-line-short"></div>
            <div class="source-note"><b>Evidence</b><div class="mock-line"></div><div class="mock-line mock-line-short"></div></div>
          </div>
          <div class="reqsy-steps">
            <strong>Workflow</strong>
            {steps.map((step, index) => <span><i>{index + 1}</i>{step}</span>)}
          </div>
        </div>
      </div>
    )}
    {visual === 'pixelpeek' && (
      <div class="pixel-scene">
        <div class="app-window pixel-window">
          <div class="window-bar"><span class="window-buttons"><i></i><i></i><i></i></span><strong>Pixelpeek</strong><span>Host dashboard</span></div>
          <div class="pixel-dashboard">
            <p>Device session</p>
            <strong>Android WebView</strong>
            <div class="pixel-status"><b>Paired device</b><span>Connected</span></div>
            <div class="pixel-action"><span>Tap</span><span>Scroll</span><span>Capture</span></div>
          </div>
        </div>
        <div class="pixel-phone">
          <div class="pixel-camera"></div>
          <div class="pixel-webview"><b>WebView</b><div class="mock-line"></div><div class="mock-line mock-line-short"></div><i></i></div>
          <div class="pixel-home"></div>
        </div>
      </div>
    )}
    {visual === 'catercore' && (
      <div class="app-window paper-window">
        <div class="window-bar"><span class="window-buttons"><i></i><i></i><i></i></span><strong>CaterCore</strong><span>Operations</span></div>
        <div class="cater-body">
          <strong>Event intake</strong>
          <div class="mock-table">
            <div class="mock-table-head"><span>Event</span><span>Type</span><span>Status</span></div>
            {records.map((record) => <div><b>{record.name}</b><span>{record.type}</span><span>{record.status}</span></div>)}
          </div>
        </div>
      </div>
    )}
    {visual === 'stevie' && (
      <div class="app-window paper-window">
        <div class="window-bar"><span class="window-buttons"><i></i><i></i><i></i></span><strong>Stevie Intel</strong><span>Awards search</span></div>
        <div class="stevie-body">
          <strong>Search past winners</strong>
          <div class="mock-search">Show past winners in the customer service category</div>
          <div class="mock-response"><b>Results overview</b><div class="mock-line"></div><div class="mock-line mock-line-short"></div></div>
        </div>
      </div>
    )}
    {visual === 'tracking' && (
      <div class="app-window paper-window">
        <div class="window-bar"><span class="window-buttons"><i></i><i></i><i></i></span><strong>Link Tracker</strong><span>Click reporting</span></div>
        <div class="tracking-body">
          <div class="tracking-report">
            <strong>Traffic by channel</strong>
            <div class="tracking-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="tracking-legend"><strong>Referrers</strong><span>Social</span><span>Email</span><span>Direct or unknown</span></div>
        </div>
      </div>
    )}
  </div>
  <figcaption>{captions[visual]}</figcaption>
</figure>
