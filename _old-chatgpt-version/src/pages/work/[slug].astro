---
import Site from '../../layouts/Site.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects } from '../../data/portfolio';
import type { Project } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, nextProject: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  nextProject: Project;
}

const { project, nextProject } = Astro.props;
---

<Site title={project.title} description={project.summary}>
  <article class="case-study" style={`--project-accent: ${project.accent}`}>
    <header class="case-hero">
      <div class="frame">
        <a class="text-link case-back" href={project.featured ? '/#work' : '/#experience'}>{project.featured ? 'All selected work' : 'Back to experience'}</a>
        <div class="case-heading">
          <p class="eyebrow"><span class="label-line"></span><span>{project.category}{project.year && <> · <time datetime={project.year}>{project.year}</time></>}</span></p>
          <h1 class="display">{project.title}<span class="name-period">.</span></h1>
          <p>{project.summary}</p>
        </div>
        <dl class="case-meta">
          <div><dt>My role</dt><dd>{project.role}</dd></div>
          <div><dt>Tools</dt><dd>{project.stack.join(' · ')}</dd></div>
        </dl>
        <div class="case-art" data-enter><ProjectVisual visual={project.visual} eager /></div>
      </div>
    </header>
    <div class="frame case-content">
      {project.sections.map((section) => (
        <section class="case-section" data-enter>
          <h2>{section.title}</h2>
          <div>{section.body.map((paragraph) => <p>{paragraph}</p>)}</div>
        </section>
      ))}
      {project.links.length > 0 && (
        <section class="case-section">
          <h2>Project links</h2>
          <ul class="case-links" role="list">
            {project.links.map((link) => <li><a class="text-link" href={link.href}>{link.label}</a></li>)}
          </ul>
        </section>
      )}
    </div>
    <div class="case-next" data-enter>
      <a class="frame" href={`/work/${nextProject.slug}/`}>
        <span class="eyebrow"><span class="label-line"></span> Next case study</span>
        <span class="display">{nextProject.title}<span class="name-period">.</span></span>
      </a>
    </div>
  </article>
</Site>
