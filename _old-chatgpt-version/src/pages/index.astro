---
import Site from '../layouts/Site.astro';
import Portrait from '../components/Portrait.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import SceneNext from '../components/SceneNext.astro';
import { certifications, experience, profile, projects, skills } from '../data/portfolio';

const featured = projects.filter((project) => project.featured);
const internship = projects.filter((project) => experience.projects.includes(project.slug));
---

<Site intro>
  <section class="hero" aria-labelledby="intro-title">
    <div class="frame hero-grid">
      <div class="hero-copy">
        <h1 id="intro-title" class="hero-name" aria-label={profile.name}>
          <span class="name-window" aria-hidden="true"><span>Ankitha</span></span>
          <span class="name-window" aria-hidden="true"><span>Reddy</span></span>
          <span class="name-window" aria-hidden="true"><span>Atukula<span class="name-period">.</span></span></span>
        </h1>
      </div>
      <Portrait />
      <div class="hero-intro">
        <p class="eyebrow"><span class="label-line"></span> {profile.title}</p>
        <p class="hero-lead">{profile.intro}</p>
        <div class="hero-actions">
          <SceneNext href="#work" title="Selected work" />
          <a class="text-link" href="#contact">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="selected" id="work" aria-labelledby="work-title">
    <div class="frame" id="projects">
      <div class="selected-heading" data-enter>
        <h2 class="display" id="work-title">Selected <em>work.</em></h2>
        <div class="section-signal" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>
      <nav class="chapter-nav" aria-label="Selected work">
        {featured.map((project) => <a href={`#${project.slug}`}>{project.title}</a>)}
      </nav>
      <div class="features">
        {featured.map((project) => (
          <article class="feature" id={project.slug} style={`--project-accent: ${project.accent}`} data-enter>
            <div class="feature-copy">
              <p class="eyebrow feature-category"><span class="label-line"></span><span>{project.category}{project.year && <> · <time datetime={project.year}>{project.year}</time></>}</span></p>
              <h3>{project.title}</h3>
              <p class="feature-summary">{project.summary}</p>
              <ul class="tech-list" role="list" aria-label="Highlights">
                {project.stack.slice(0, 3).map((item) => <li>{item}</li>)}
              </ul>
              <a class="button feature-button" href={`/work/${project.slug}/`} aria-label={`Read the ${project.title} case study`}>Case study</a>
            </div>
            <ProjectVisual visual={project.visual} />
          </article>
        ))}
      </div>
      <div class="scene-end" data-enter><SceneNext href="#experience" title="Experience" /></div>
    </div>
  </section>

  <section class="experience frame" id="experience" aria-labelledby="experience-title">
    <div class="split-heading" data-enter>
      <h2 class="display" id="experience-title">Experience<span class="name-period">.</span></h2>
    </div>
    <div class="timeline-row experience-body" data-enter>
      <div class="timeline-date">
        <time datetime={experience.year}>{experience.year}</time>
        <span>{experience.duration}</span>
      </div>
      <div class="timeline-content">
        <h3>{experience.organization}</h3>
        <p class="job-role">{experience.role}</p>
        <p class="experience-summary">{experience.summary}</p>
        <ul class="experience-projects" role="list">
          {internship.map((project) => <li><a href={`/work/${project.slug}/`}><span>{project.title}</span><span>{project.role}</span></a></li>)}
        </ul>
      </div>
    </div>
    <div class="scene-end" data-enter><SceneNext href="#education" title="Education" /></div>
  </section>

  <section class="education" id="education" aria-labelledby="education-title">
    <div class="frame">
      <div class="split-heading" data-enter>
        <h2 class="display" id="education-title">Education<span class="name-period">.</span></h2>
      </div>
      {profile.education.map((entry) => (
        <article class="timeline-row education-row" data-enter>
          <div class="timeline-date"><span class="date-range">{entry.dates}</span></div>
          <div class="timeline-content">
            <h3>{entry.qualification}</h3>
            <p>{entry.school}</p>
            <p class="education-result">{entry.result}</p>
          </div>
        </article>
      ))}
      <div class="scene-end" data-enter><SceneNext href="#about" title="About me" /></div>
    </div>
  </section>

  <section class="about frame" id="about" aria-labelledby="about-title">
    <div class="about-top" data-enter>
      <h2 class="display" id="about-title">About <em>me.</em></h2>
      <div class="about-copy">{profile.about.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
    <div class="skill-block" id="skills">
      <h3>Skills</h3>
      <div class="skill-grid">
        {skills.map((group) => (
          <div class="skill-group" data-enter>
            <h4>{group.name}</h4>
            <ul role="list">{group.items.map((skill) => <li>{skill}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
    <div class="about-footer" data-enter>
      <h3>Certifications & training</h3>
      <ul role="list">{certifications.map((name) => <li>{name}</li>)}</ul>
    </div>
    <div class="scene-end" data-enter><SceneNext href="#contact" title="Contact" /></div>
  </section>
</Site>
